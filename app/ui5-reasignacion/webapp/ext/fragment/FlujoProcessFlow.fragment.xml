<!--
    Sección personalizada del Object Page: "Flujo de Aprobación". Registrada
    en manifest.json (routing > targets > PropuestasEnCursoObjectPage >
    options > settings > content > body > sections).

    Enlaza dos colecciones que CAP ya entrega calculadas
    (srv/domain/historial.service.js, compartido con la app de aprobaciones):
      niveles     → lanes  (columnas: Analista → Apoderados → Liberador)
      aprobadores → nodes  (tarjeta por firmante, con su estado ya resuelto)
    Los únicos formatters son conversiones de tipo que OData V4 impide hacer
    en el servidor; ver ext/util/Historial.js.

    A diferencia de la app de aprobaciones, aquí el diagrama es real y no de
    demostración: el servicio ve todas las tareas vivas de la propuesta, así
    que puede deducir quién firmó sin depender del iFlow de historial. Lo que
    no puede saber sin ese iFlow son las fechas y comentarios de los pasos ya
    firmados (viven en Payroll); de ahí el aviso de abajo.

    La tarjeta se define cuatro veces porque ProcessFlow elige su nivel de
    zoom según el ANCHO DEL CONTROL, no de la ventana (< 600px → Four,
    600-1023px → Three, >= 1024px → Two), y cada nivel dibuja solo su propia
    agregación zoomLevel*Content:
      One   máximo detalle (zoom manual): + fecha y comentario
      Two   pantalla ancha: foto, nombre, cargo y decisión
      Three columna media del FCL (el caso habitual aquí): foto pequeña, nombre y decisión
      Four  móvil: solo la foto/iniciales

    flexEnabled: true exige IDs estables en todo control de un fragmento; el
    binding de agregación de UI5 les añade el sufijo del índice de fila al
    clonarlas (flujoProcessFlow-0, -1, …), así que siguen siendo únicos.
-->
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:pf="sap.suite.ui.commons">

    <VBox id="flujoContenedor" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom h2hFlujoDesplazable">

        <MessageStrip
            id="flujoAvisoSinFechas"
            text="{i18n>flujoSinFechasAviso}"
            type="Information"
            showIcon="true"
            class="sapUiSmallMarginBottom" />

        <!--
            Barra de zoom: el nivel del ProcessFlow no es una propiedad
            enlazable de forma útil (el control lo recalcula desde su propio
            ancho en cada resize), así que se usan sus métodos zoomIn()/
            zoomOut() (ver ext/util/Historial.js). Al redimensionar el
            control (abrir/cerrar columna del FCL) el zoom manual se descarta.

            core:require va aquí y no en el VBox contenedor porque la
            plantilla de los nodos se clona por fila y necesita el suyo propio.
        -->
        <Toolbar
            id="flujoBarraZoom"
            core:require="{ Historial: 'centria/h2hpp/aprobaciones/ui5reasignacion/ext/util/Historial' }"
            design="Transparent"
            style="Clear"
            width="100%">
            <Button
                id="flujoAcercar"
                icon="sap-icon://zoom-in"
                type="Transparent"
                text="{i18n>flujoAcercarBoton}"
                press="Historial.acercar" />
            <Button
                id="flujoAlejar"
                icon="sap-icon://zoom-out"
                type="Transparent"
                text="{i18n>flujoAlejarBoton}"
                press="Historial.alejar" />
        </Toolbar>

        <!--
            h2hFlujoCentrado centra el diagrama con margin automático, no con
            alineación flex: con zoom, un hijo centrado por align-items queda
            recortado por la izquierda cuando es más ancho que su caja y esa
            parte deja de alcanzarse con scroll. Ver webapp/css/estilos.css.
        -->
        <pf:ProcessFlow
            id="flujoProcessFlow"
            class="h2hFlujoCentrado"
            lanes="{ path: 'niveles', templateShareable: false }"
            nodes="{ path: 'aprobadores', templateShareable: false }"
            scrollable="false"
            wheelZoomable="false"
            foldedCorners="false"
            showLabels="false">

            <!--
                El anillo semántico de la cabecera del lane no se enlaza: lo
                calcula el propio control agregando el `state` de sus nodos y
                lo reescribe en cada render. El color sigue saliendo de la
                lógica de negocio porque `estadoNodo` lo decide CAP.
            -->
            <pf:lanes>
                <pf:ProcessFlowLaneHeader
                    id="flujoNivel"
                    laneId="{laneId}"
                    position="{posicion}"
                    text="{texto}"
                    iconSrc="{icono}"
                    tooltip="{resumen}" />
            </pf:lanes>

            <!-- Nodos: una tarjeta por firmante -->
            <pf:nodes>
                <!--
                    core:require va en este nodo (no en FragmentDefinition,
                    que no propaga la directiva a su subárbol).

                    En `children`, targetType:'any' evita que UI5 intente
                    convertir el valor al tipo de la propiedad de destino
                    (any[]) antes del formatter, lo que rompía el diagrama sin
                    ninguna flecha de conexión.

                    No se enlaza `highlighted`: basta un nodo resaltado para
                    que ProcessFlow recalcule el anillo de todos los niveles
                    contando solo los resaltados. El paso en curso ya se
                    distingue por `focused`.
                -->
                <pf:ProcessFlowNode
                    id="flujoNodo"
                    core:require="{ Historial: 'centria/h2hpp/aprobaciones/ui5reasignacion/ext/util/Historial' }"
                    nodeId="{nodeId}"
                    laneId="{laneId}"
                    children="{ path: 'hijos', targetType: 'any', formatter: 'Historial.aLista' }"
                    state="{estadoNodo}"
                    stateText="{estadoTexto}"
                    focused="{esActual}"
                    title="{nombre}"
                    titleAbbreviation="{iniciales}">

                    <!-- Zoom 1 — máximo detalle (zoom manual) -->
                    <pf:zoomLevelOneContent>
                        <VBox id="flujoZ1Caja" alignItems="Center" justifyContent="Center">
                            <Avatar
                                id="flujoZ1Foto"
                                src="{ path: 'fotoUrl', formatter: 'Historial.foto' }"
                                initials="{iniciales}"
                                displaySize="M"
                                displayShape="Square"
                                fallbackIcon="sap-icon://employee"
                                backgroundColor="Accent6"
                                tooltip="{usuario}" />
                            <Title id="flujoZ1Nombre" text="{nombre}" level="H6" wrapping="true"
                                textAlign="Center" class="sapUiTinyMarginTop" />
                            <Text id="flujoZ1Cargo" text="{cargo}" textAlign="Center" maxLines="2" />
                            <ObjectStatus id="flujoZ1Estado" text="{decisionTexto}"
                                state="{decisionValueState}" class="sapUiTinyMarginTop" />
                            <!-- targetType:'any': en un binding de expresión, convertir la fecha a boolean lanzaría FormatException. -->
                            <Text id="flujoZ1Fecha" text="{fechaTexto}" textAlign="Center"
                                visible="{= !!${path:'fechaTexto', targetType:'any'} }" />
                            <Text id="flujoZ1Comentario" text="{comentario}" textAlign="Center" maxLines="3"
                                visible="{= !!${path:'comentario', targetType:'any'} }" />
                        </VBox>
                    </pf:zoomLevelOneContent>

                    <!-- Zoom 2 — pantalla ancha (>= 1024px de ancho del control) -->
                    <pf:zoomLevelTwoContent>
                        <VBox id="flujoZ2Caja" alignItems="Center" justifyContent="Center">
                            <Avatar
                                id="flujoZ2Foto"
                                src="{ path: 'fotoUrl', formatter: 'Historial.foto' }"
                                initials="{iniciales}"
                                displaySize="S"
                                displayShape="Square"
                                fallbackIcon="sap-icon://employee"
                                backgroundColor="Accent6"
                                tooltip="{usuario}" />
                            <Title id="flujoZ2Nombre" text="{nombre}" level="H6" wrapping="true"
                                textAlign="Center" class="sapUiTinyMarginTop" />
                            <Text id="flujoZ2Cargo" text="{cargo}" textAlign="Center" maxLines="2" />
                            <ObjectStatus id="flujoZ2Estado" text="{decisionTexto}"
                                state="{decisionValueState}" class="sapUiTinyMarginTop" />
                        </VBox>
                    </pf:zoomLevelTwoContent>

                    <!-- Zoom 3 — columna media del FCL: el caso habitual aquí -->
                    <pf:zoomLevelThreeContent>
                        <VBox id="flujoZ3Caja" alignItems="Center" justifyContent="Center">
                            <Avatar
                                id="flujoZ3Foto"
                                src="{ path: 'fotoUrl', formatter: 'Historial.foto' }"
                                initials="{iniciales}"
                                displaySize="XS"
                                displayShape="Square"
                                fallbackIcon="sap-icon://employee"
                                backgroundColor="Accent6"
                                tooltip="{usuario}" />
                            <Title id="flujoZ3Nombre" text="{nombre}" level="H6" wrapping="true"
                                textAlign="Center" class="sapUiTinyMarginTop" />
                            <ObjectStatus id="flujoZ3Estado" text="{decisionTexto}"
                                state="{decisionValueState}" />
                        </VBox>
                    </pf:zoomLevelThreeContent>

                    <!-- Zoom 4 — móvil: el nodo es diminuto, solo cabe la foto -->
                    <pf:zoomLevelFourContent>
                        <VBox id="flujoZ4Caja" alignItems="Center" justifyContent="Center">
                            <Avatar
                                id="flujoZ4Foto"
                                src="{ path: 'fotoUrl', formatter: 'Historial.foto' }"
                                initials="{iniciales}"
                                displaySize="XS"
                                displayShape="Square"
                                fallbackIcon="sap-icon://employee"
                                backgroundColor="Accent6"
                                tooltip="{nombre}" />
                        </VBox>
                    </pf:zoomLevelFourContent>
                </pf:ProcessFlowNode>
            </pf:nodes>
        </pf:ProcessFlow>
    </VBox>
</core:FragmentDefinition>
