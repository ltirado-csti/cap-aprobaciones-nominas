{
  "_version": "1.65.0",
  "sap.app": {
    "id": "centria.h2hpp.aprobaciones.ui5reasignacion",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/nomina/reasignacion/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadata.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "NominaReasignacion-display": {
          "semanticObject": "NominaReasignacion",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://employee-approvals",
          "info": "{{appDescription}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "offline": false
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://replace"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "centria.h2hpp.aprobaciones.ui5reasignacion.ext.controller.ListaHandler"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "centria.h2hpp.aprobaciones.ui5reasignacion.ext.controller.DetalleHandler"
          }
        }
      }
    },
    "dependencies": {
      "minUI5Version": "1.148.1",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.suite.ui.commons": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "centria.h2hpp.aprobaciones.ui5reasignacion.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.core.rootView.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    },
    "routing": {
      "config": {
        "routerClass": "sap.f.routing.Router",
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded"
        }
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PropuestasEnCursoList",
          "target": "PropuestasEnCursoList"
        },
        {
          "pattern": "PropuestasEnCurso({key}):?query:",
          "name": "PropuestasEnCursoObjectPage",
          "target": [
            "PropuestasEnCursoList",
            "PropuestasEnCursoObjectPage"
          ]
        }
      ],
      "targets": {
        "PropuestasEnCursoList": {
          "type": "Component",
          "id": "PropuestasEnCursoList",
          "name": "sap.fe.templates.ListReport",
          "controlAggregation": "beginColumnPages",
          "contextPattern": "",
          "options": {
            "settings": {
              "entitySet": "PropuestasEnCurso",
              "variantManagement": "None",
              "initialLoad": true,
              "navigation": {
                "PropuestasEnCurso": {
                  "detail": {
                    "route": "PropuestasEnCursoObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None",
                    "enableExport": true,
                    "enableFullScreen": false,
                    "personalization": false
                  },
                  "columns": {
                    "grupoPropuesta": { "width": "16rem" },
                    "estadoPropuesta": { "width": "14rem" },
                    "destinatarios": { "width": "18rem" },
                    "importeTexto": { "width": "10rem" },
                    "banco": { "width": "7rem" }
                  }
                }
              }
            }
          }
        },
        "PropuestasEnCursoObjectPage": {
          "type": "Component",
          "id": "PropuestasEnCursoObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "controlAggregation": "midColumnPages",
          "contextPattern": "PropuestasEnCurso({key})",
          "options": {
            "settings": {
              "entitySet": "PropuestasEnCurso",
              "editableHeaderContent": false,
              "controlConfiguration": {
                "firmantes/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None",
                    "personalization": false
                  },
                  "columns": {
                    "rol": { "width": "8rem" },
                    "usuario": { "width": "14rem" },
                    "estadoFirmante": { "width": "8rem" },
                    "motivoNoReasignable": { "width": "18rem" }
                  }
                }
              },
              "content": {
                "body": {
                  "sections": {
                    "FlujoAprobacion": {
                      "template": "centria.h2hpp.aprobaciones.ui5reasignacion.ext.fragment.FlujoProcessFlow",
                      "title": "{i18n>flujoSeccionTitulo}",
                      "position": {
                        "placement": "After",
                        "anchor": "Firmantes"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "service": "centria.h2hpp.aprobaciones",
    "public": true
  },
  "sap.fe": {
    "app": {
      "share": {
        "showSendEmail": false,
        "showSaveAsTile": false
      }
    }
  }
}
