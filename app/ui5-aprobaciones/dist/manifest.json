{
	"_version": "1.65.0",
	"sap.app": {
		"id": "centria.h2hpp.aprobaciones.ui5aprobaciones",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "1.0.0"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"dataSources": {
			"mainService": {
				"uri": "/nomina/aprobaciones/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0",
					"localUri": "localService/metadata.xml"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"NominaAprobacion-display": {
					"semanticObject": "NominaAprobacion",
					"action": "display",
					"title": "{{appTitle}}",
					"subTitle": "{{appSubTitle}}",
					"icon": "sap-icon://workflow-tasks",
					"info": "{{appDescription}}",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		},
		"offline": false
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "sap-icon://inbox"
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": true,
		"dependencies": {
			"minUI5Version": "1.148.1",
			"libs": {
				"sap.m": {},
				"sap.f": {},
				"sap.ui.core": {},
				"sap.fe.templates": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "centria.h2hpp.aprobaciones.ui5aprobaciones.i18n.i18n",
					"supportedLocales": [
						""
					],
					"fallbackLocale": ""
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"synchronizationMode": "None",
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			}
		},
		"rootView": {
			"viewName": "sap.fe.core.rootView.Fcl",
			"type": "XML",
			"async": true,
			"id": "appRootView"
		},
		"routing": {
			"config": {
				"routerClass": "sap.f.routing.Router",
				"flexibleColumnLayout": {
					"defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
					"defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
				}
			},
			"routes": [
				{
					"pattern": ":?query:",
					"name": "TareasInboxList",
					"target": "TareasInboxList"
				},
				{
					"pattern": "TareasInbox({key}):?query:",
					"name": "TareasInboxObjectPage",
					"target": [
						"TareasInboxList",
						"TareasInboxObjectPage"
					]
				}
			],
			"targets": {
				"TareasInboxList": {
					"type": "Component",
					"id": "TareasInboxList",
					"name": "sap.fe.templates.ListReport",
					"controlAggregation": "beginColumnPages",
					"contextPattern": "",
					"options": {
						"settings": {
							"entitySet": "TareasInbox",
							"variantManagement": "None",
							"initialLoad": true,
							"hideFilterBar": true,
							"navigation": {
								"TareasInbox": {
									"detail": {
										"route": "TareasInboxObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable",
										"selectionMode": "None",
										"enableExport": true,
										"enableFullScreen": false
									}
								}
							}
						}
					}
				},
				"TareasInboxObjectPage": {
					"type": "Component",
					"id": "TareasInboxObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"controlAggregation": "midColumnPages",
					"contextPattern": "TareasInbox({key})",
					"options": {
						"settings": {
							"entitySet": "TareasInbox",
							"editableHeaderContent": false,
							"controlConfiguration": {
								"proveedores/@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								},
								"adjuntos/@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								},
								"aprobadores/@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable"
									}
								}
							}
						}
					}
				}
			}
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.cloud": {
		"service": "centria.h2hpp.aprobaciones",
		"public": true
	},
	"sap.fe": {
		"app": {
			"share": {
				"showSendEmail": false
			}
		}
	}
}